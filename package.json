{
  "name": "still",
  "version": "0.1.0",
  "private": true,
  "description": "Still — a scheduled, non-clinical check-in steward for students (PS #16).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch --import tsx server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && npm run server",
    "server": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx scripts/eval.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "playwright": "1.56",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  }
}
