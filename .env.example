# Which classifier runs after the crisis-phrase backstop:
#   groq   — Groq free tier (text is sent to api.groq.com)
#   ollama — local Ollama (text stays on this laptop)
#   local  — deterministic in-process rules (no model, text stays in-process)
CLASSIFIER_PROVIDER=local

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

CLASSIFIER_TIMEOUT_MS=6000
PORT=8787
# Where SQLite lives. Only schedule + check-in metadata are stored.
STILL_DB_PATH=data/still.db
# How often the server-side scheduler looks for due check-ins.
SCHEDULER_TICK_MS=15000

# Postgres instead of SQLite (Vercel: Storage → Neon injects this). Leave empty to use SQLite.
DATABASE_URL=
# Key for sealing the one-clarification hold (AES-256-GCM). Set any long random string in production;
# if empty, a random per-process key is used (fine on one laptop).
STILL_SECRET=
